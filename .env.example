POSTGRES_DB=influence
POSTGRES_USER=influence
POSTGRES_PASSWORD=influence
BACKEND_PORT=8001

# Protects the administrator-only crawl endpoint. Never commit real values.
COLLECTOR_ADMIN_KEY=

# Identify the crawler honestly; include a public contact or policy URL in production.
CRAWLER_USER_AGENT=InfluenceCrawler/1.0
CRAWLER_REQUEST_DELAY_SECONDS=2.0
# Optional comma-separated allowlist. Empty means any public host allowed by robots.txt.
CRAWLER_ALLOWED_DOMAINS=

# Run `python3 scripts/setup_brightdata.py` to configure these values securely.
# Use brightdata for public Instagram URL collection through a managed provider.
INFLUENCER_PROVIDER=public_web
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_INSTAGRAM_PROFILE_DATASET_ID=gd_l1vikfch901nx3by4
BRIGHTDATA_BASE_URL=https://api.brightdata.com
